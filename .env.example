# ─────────────────────────────────────────────────────────────────────
# Spec-Driven Development Pipeline — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────

# ── JIRA ────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
JIRA_USER_EMAIL=your-email@example.com
JIRA_PROJECT_KEY=PROJ

# Label that makes a ticket eligible for automation.
QUALIFYING_LABEL=SpecDrivenDev

# ── GitLab ──────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_API_TOKEN=your-gitlab-private-token
GITLAB_REPO_ID=12345

# ── NVIDIA NIM / LLM ───────────────────────────────────────────────
NIM_API_KEY=your-nim-api-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=z-ai/glm-5.3
NIM_FALLBACK_MODEL=deepseek-ai/deepseek-v4-pro

# ── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_CAP=32

# ── Checkpointing & audit ──────────────────────────────────────────
CHECKPOINT_DIR=./checkpoints
AUDIT_DIR=./audit

# ── Code-generation loop ───────────────────────────────────────────
MAX_CODE_ITERATIONS=6
COVERAGE_THRESHOLD=80

# ── SonarQube (Phase 2+) ──────────────────────────────────────────
SONAR_HOST_URL=
SONAR_TOKEN=

# ── Human gate polling ─────────────────────────────────────────────
GATE_POLL_INTERVAL_SECONDS=30
GATE_TIMEOUT_HOURS=48

# ── Escalation / notifications ─────────────────────────────────────
SLACK_WEBHOOK_URL=
ESCALATION_EMAIL=
