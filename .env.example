# ─────────────────────────────────────────────────────────────────────
# Spec-Driven Development Pipeline — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────

# ── Platform Selection ──────────────────────────────────────────────
PLATFORM=github

# ── GitHub (Default Mode) ───────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_personal_access_token_or_app_token
GITHUB_REPO=your-org/your-repo
GITHUB_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_AUDIT_REPO=your-org/your-audit-logs
GITHUB_WORKFLOW_FILE=spec-driven-dev-ci.yml

# ── JIRA (Legacy / Alternative Mode) ────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
JIRA_USER_EMAIL=your-email@example.com
JIRA_PROJECT_KEY=PROJ

# Label that makes an issue/ticket eligible for automation.
QUALIFYING_LABEL=SpecDrivenDev

# ── GitLab ──────────────────────────────────────────────────────────
GITLAB_BASE_URL=https://gitlab.com
GITLAB_API_TOKEN=your-gitlab-private-token
GITLAB_REPO_ID=12345

# ── NVIDIA NIM / LLM ───────────────────────────────────────────────
NIM_API_KEY=your-nim-api-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=z-ai/glm-5.3
NIM_FALLBACK_MODEL=deepseek-ai/deepseek-v4-pro

# ── Rate limiting ───────────────────────────────────────────────────
RATE_LIMIT_CAP=32

# ── Checkpointing & audit ──────────────────────────────────────────
CHECKPOINT_DIR=./checkpoints
AUDIT_DIR=./audit

# ── Code-generation loop ───────────────────────────────────────────
MAX_CODE_ITERATIONS=6
COVERAGE_THRESHOLD=80

# ── CI/CD pipeline polling ─────────────────────────────────────────
CI_POLL_INTERVAL_SECONDS=30
CI_TIMEOUT_MINUTES=30

# ── SonarQube ─────────────────────────────────────────────────────
SONAR_HOST_URL=
SONAR_TOKEN=

# ── Human gate polling ─────────────────────────────────────────────
GATE_POLL_INTERVAL_SECONDS=30
GATE_TIMEOUT_HOURS=48

# ── Escalation / notifications ─────────────────────────────────────
SLACK_WEBHOOK_URL=
ESCALATION_EMAIL=

# ── Webhook service (Phase 3) ──────────────────────────────────────
JIRA_WEBHOOK_SECRET=your-jira-webhook-secret
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
GITLAB_WEBHOOK_SECRET=

# ── Reviewer feedback loop (Phase 3) ───────────────────────────────
MAX_REVIEW_ITERATIONS=3

# ── Audit shipping & SIEM (Phase 4) ────────────────────────────────
AUDIT_SHIPPING_MODE=none
AUDIT_GITLAB_REPO_ID=
SIEM_WEBHOOK_URL=

# ── Concurrency & Multi-Repo Scaling (Phase 5) ─────────────────────
MAX_CONCURRENT_TICKETS=2
REPO_MAPPING={"frontend": 12345, "backend": 67890}
ENABLE_CONTEXT_PRUNING=false
MAX_CONTEXT_TOKENS=131072


